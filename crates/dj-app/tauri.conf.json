{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "djmanzo",
  "version": "0.0.2",
  "identifier": "app.djmanzo.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../ui run dev",
    "beforeBuildCommand": "npm --prefix ../../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "djmanzo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: wave: http://asset.localhost http://wave.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "VirtualDJ-class DJ application",
    "longDescription": "A DJ application for macOS and Linux with a Rust realtime audio engine."
  }
}
