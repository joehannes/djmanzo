{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "djmanzo",
  "version": "0.1.3",
  "identifier": "app.djmanzo.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node build-ui.js dev",
    "beforeBuildCommand": "node build-ui.js build"
  },
  "app": {
    "windows": [
      {
        "title": "djmanzo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: wave: brand: http://asset.localhost http://wave.localhost http://brand.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "VirtualDJ-class DJ application",
    "longDescription": "A DJ application for macOS and Linux with a Rust realtime audio engine.",
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ]
      }
    }
  }
}
