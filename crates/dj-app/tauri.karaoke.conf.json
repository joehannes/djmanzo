{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "djmanzo Karaoke",
  "identifier": "app.djmanzo.karaoke",
  "build": {
    "beforeBuildCommand": "node dj-app/build-ui.cjs build:karaoke"
  },
  "app": {
    "windows": [
      {
        "title": "djmanzo Karaoke",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "theme": null
      }
    ]
  },
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "shortDescription": "djmanzo for karaoke nights",
    "longDescription": "djmanzo built for karaoke nights: the singers' screen, the queue, vocals out, lyrics and the room's sign-up page, for older Macs back to macOS 10.13 (High Sierra)."
  }
}
